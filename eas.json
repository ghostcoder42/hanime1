{
  "cli": {
    "version": ">= 3.8.1",
    "appVersionSource": "local"
  },
  "build": {
    "production": {
      "environment": "production",
      "channel": "production",
      "distribution": "internal",
      "bun": "1.3.14",
      "cache": {
        "key": "android-build-1",
        "paths": ["~/.gradle/caches", "~/.gradle/wrapper", "~/.cache/ccache"]
      },
      "ios": {
        "image": "latest"
      },
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "env": {
        "APP_ENV": "production",
        "FLIPPER_DISABLE": "1",
        "EAS_USE_CACHE": "1"
      }
    },
    "staging": {
      "channel": "staging",
      "distribution": "internal",
      "bun": "1.3.14",
      "cache": {
        "key": "android-build-1",
        "paths": ["~/.gradle/caches", "~/.gradle/wrapper", "~/.cache/ccache"]
      },
      "ios": {
        "image": "latest"
      },
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "env": {
        "APP_ENV": "staging",
        "FLIPPER_DISABLE": "1",
        "EAS_USE_CACHE": "1"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "bun": "1.3.14",
      "ios": {
        "image": "latest"
      },
      "android": {
        "image": "latest"
      },
      "env": {
        "APP_ENV": "development"
      }
    },
    "simulator": {
      "ios": {
        "simulator": true,
        "image": "latest"
      },
      "android": {
        "image": "latest"
      },
      "env": {
        "APP_ENV": "development"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
